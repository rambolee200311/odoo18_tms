<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_carrier_profile_tree" model="ir.ui.view">
        <field name="name">tlmp.carrier.profile.tree</field>
        <field name="model">tlmp.carrier.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="carrier_code"/>
                <field name="partner_id"/>
                <field name="carrier_type"/>
                <field name="settlement_mode"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>
    <record id="view_tlmp_carrier_profile_form" model="ir.ui.view">
        <field name="name">tlmp.carrier.profile.form</field>
        <field name="model">tlmp.carrier.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="carrier_code"/>
                            <field name="carrier_type"/>
                        </group>
                        <group>
                            <field name="settlement_mode"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tlmp_carrier_profile" model="ir.actions.act_window">
        <field name="name">Carrier Profiles</field>
        <field name="res_model">tlmp.carrier.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
