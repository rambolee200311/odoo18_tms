<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_carrier_inquiry_wizard_form" model="ir.ui.view">
        <field name="name">tlmp.create.carrier.inquiry.wizard.form</field>
        <field name="model">tlmp.create.carrier.inquiry.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Carrier Inquiry">
                <group>
                    <group>
                        <field name="request_id" readonly="1"
                               options="{'no_open': True, 'no_create': True}"/>
                        <field name="carrier_id" options="{'no_create': True}"/>
                        <field name="response_date"/>
                        <field name="validity_date"/>
                    </group>
                    <group>
                        <field name="unit_price"/>
                        <field name="quantity"/>
                        <field name="carrier_cost" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="carrier_notes"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
