<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_customer_quote_wizard_form" model="ir.ui.view">
        <field name="name">tlmp.create.customer.quote.wizard.form</field>
        <field name="model">tlmp.create.customer.quote.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Customer Quote">
                <group>
                    <group>
                        <field name="request_id" readonly="1"
                               options="{'no_open': True, 'no_create': True}"/>
                        <field name="inquiry_id" options="{'no_create': True}"/>
                        <field name="carrier_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="carrier_cost" readonly="1"/>
                        <field name="margin_rate"/>
                        <field name="service_fee"/>
                        <field name="customer_price" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
