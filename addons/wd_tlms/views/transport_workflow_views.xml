<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tlmp_workflow_ledger_tree" model="ir.ui.view">
        <field name="name">tlmp.transport.event.ledger.tree</field>
        <field name="model">tlmp.transport.event.ledger</field>
        <field name="arch" type="xml">
            <list string="Workflow Ledger" default_order="create_date desc, id desc">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="event_category" widget="badge"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="from_state"/>
                <field name="to_state"/>
                <field name="create_uid"/>
            </list>
        </field>
    </record>

    <record id="view_tlmp_workflow_ledger_form" model="ir.ui.view">
        <field name="name">tlmp.transport.event.ledger.form</field>
        <field name="model">tlmp.transport.event.ledger</field>
        <field name="arch" type="xml">
            <form string="Workflow Ledger Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="event_type" readonly="1"/>
                            <field name="event_category" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                        <group>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="from_state" readonly="1"/>
                            <field name="to_state" readonly="1"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tlmp_workflow_ledger_search" model="ir.ui.view">
        <field name="name">tlmp.transport.event.ledger.search</field>
        <field name="model">tlmp.transport.event.ledger</field>
        <field name="arch" type="xml">
            <search string="Workflow Ledger">
                <field name="event_type"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <filter string="State Events" name="state"
                        domain="[('event_category', '=', 'state')]"/>
                <filter string="Business Events" name="business"
                        domain="[('event_category', '=', 'business')]"/>
                <filter string="Integration Events" name="integration"
                        domain="[('event_category', '=', 'integration')]"/>
            </search>
        </field>
    </record>

    <record id="action_tlmp_workflow_ledger" model="ir.actions.act_window">
        <field name="name">Workflow Ledger</field>
        <field name="res_model">tlmp.transport.event.ledger</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tlmp_workflow_ledger_search"/>
    </record>

    <menuitem id="menu_tlmp_workflow_ledger" name="Workflow Ledger"
              parent="menu_tlmp_tracking_group"
              action="action_tlmp_workflow_ledger" sequence="25"/>
</odoo>
