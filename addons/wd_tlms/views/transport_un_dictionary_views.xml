<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_tlmp_un_dictionary_tree" model="ir.ui.view">
        <field name="name">tlmp.transport.un.dictionary.tree</field>
        <field name="model">tlmp.transport.un.dictionary</field>
        <field name="arch" type="xml">
            <list string="UN Dictionary" default_order="un_number">
                <field name="un_number"/>
                <field name="proper_shipping_name"/>
                <field name="hazard_class"/>
                <field name="classification_code"/>
                <field name="packing_group"/>
                <field name="tunnel_code"/>
                <field name="transport_category"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tlmp_un_dictionary_form" model="ir.ui.view">
        <field name="name">tlmp.transport.un.dictionary.form</field>
        <field name="model">tlmp.transport.un.dictionary</field>
        <field name="arch" type="xml">
            <form string="UN Entry">
                <sheet>
                    <group>
                        <group string="UN Identification">
                            <field name="un_number"/>
                            <field name="proper_shipping_name" invisible="1"/>
                            <field name="proper_shipping_name"/>
                            <field name="hazard_class"/>
                            <field name="classification_code"/>
                        </group>
                        <group string="ADR Parameters">
                            <field name="packing_group"/>
                            <field name="tunnel_code"/>
                            <field name="transport_category"/>
                            <field name="special_provision"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tlmp_un_dictionary_search" model="ir.ui.view">
        <field name="name">tlmp.transport.un.dictionary.search</field>
        <field name="model">tlmp.transport.un.dictionary</field>
        <field name="arch" type="xml">
            <search string="Search UN Dictionary">
                <field name="un_number"/>
                <field name="proper_shipping_name"/>
                <separator/>
                <filter name="active" string="Active" domain="[('is_active','=',True)]"/>
                <filter name="inactive" string="Inactive" domain="[('is_active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by':'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tlmp_un_dictionary" model="ir.actions.act_window">
        <field name="name">UN Dictionary</field>
        <field name="res_model">tlmp.transport.un.dictionary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tlmp_un_dictionary_search"/>
        <field name="help" type="html">
            <p>Maintain UN dangerous goods reference data (ADR compliant).</p>
        </field>
    </record>
</odoo>
